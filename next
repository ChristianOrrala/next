#!/usr/bin/env python3
"""next: a scratch list of what to do next, scoped to the current folder.

  next          open the list; it stays open and reloads when the file changes
  next <text>   add an item from any pane without opening the list
  next --path   print the file that holds this folder's list

The scope is the git root of the current folder, or the folder itself outside a repo.
Lists live in ~/.local/share/next/ (override with NEXT_DIR), never inside the repo.
The layout follows the pane. Tall: pending on top, done items below them, newest first, as many as
the free rows allow (at least 3, at most half). Wide (70+ columns and wider than twice the height):
pending on the left, done on the right, newest on top. The file keeps every item forever, newest first.
Nothing is selected until you move; Esc clears the selection.

Keys: a add · e/Enter edit · x/Space done or reopen · y copy · J/K move · Tab/h/l other column ·
      d delete · u undo · Esc deselect · q quit
"""
import base64
import curses
import locale
import os
import shutil
import subprocess
import sys
import time
import unicodedata

SHOW_DONE = 3    # done items a tall pane keeps below the pending ones even when those fill it
STORE = os.path.expanduser(os.environ.get("NEXT_DIR", "~/.local/share/next"))
KEYMAP = [("a", "add"), ("e", "edit"), ("x", "done"), ("y", "copy"), ("J/K", "move"), ("tab", "col"),
          ("d", "delete"), ("u", "undo"), ("esc", "deselect"), ("q", "quit")]
KEYS = "  ".join(f"{key} {what}" for key, what in KEYMAP)
SHORT_KEYS = "a e x y J K tab d u esc q"
TINY_KEYS = "a e x y d u q"
WIDE_AT = 70     # columns before the done items move to their own column
SLACK = 3        # hysteresis around the switch, so dragging a split doesn't flicker
FRESH = 3        # seconds an item added from another pane stays highlighted
NOTE = 1.5       # seconds a note like "copied" replaces the footer

# How each part is drawn. These plain attributes serve any terminal; paint() swaps in colors
# when it has 16, by ANSI slot only, so they come from the terminal's own palette.
STYLE = {"text": curses.A_NORMAL, "dim": curses.A_DIM, "bar": curses.A_REVERSE,
         "barbox": curses.A_REVERSE | curses.A_BOLD, "new": curses.A_BOLD | curses.A_UNDERLINE,
         "note": curses.A_BOLD, "head": curses.A_BOLD}


def paint():
    try:
        curses.start_color()
        curses.use_default_colors()
    except curses.error:
        return
    if curses.COLORS < 16:
        return
    # (pair, foreground slot, background slot); -1 is the terminal's own default
    for pair, fg, bg in ((1, 8, -1),    # bright black: done items, boxes, rule, footer
                         (2, -1, 0),    # black behind the default text: the selection bar
                         (3, 3, 0),     # yellow on that bar: the selected item's box
                         (4, 2, -1)):   # green: what just arrived, notes
        curses.init_pair(pair, fg, bg)
    STYLE.update(dim=curses.color_pair(1), bar=curses.color_pair(2) | curses.A_BOLD,
                 barbox=curses.color_pair(3) | curses.A_BOLD, new=curses.color_pair(4) | curses.A_BOLD,
                 note=curses.color_pair(4) | curses.A_BOLD)


def scope():
    try:
        root = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                              capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        root = ""
    return root or os.getcwd()


def list_file(root):
    return os.path.join(STORE, (root.strip("/").replace("/", "-") or "root") + ".md")


def clipboard(text):
    """Put text on the clipboard twice over: a clipboard tool fills this machine's, and the OSC 52
    escape asks the terminal you are looking at to fill its own. That one is another machine's
    when the pane is remote (ssh, herdr --remote); most terminals and multiplexers honour it."""
    copied = False
    tools = [("pbcopy", ["pbcopy"], True),
             ("wl-copy", ["wl-copy"], os.environ.get("WAYLAND_DISPLAY")),
             ("xclip", ["xclip", "-selection", "clipboard"], os.environ.get("DISPLAY")),
             ("xsel", ["xsel", "--clipboard", "--input"], os.environ.get("DISPLAY"))]
    for name, cmd, usable in tools:
        if usable and shutil.which(name):
            try:
                subprocess.run(cmd, input=text, text=True, check=True, timeout=2)
                copied = True
                break
            except (OSError, subprocess.SubprocessError):
                pass
    try:
        sys.stdout.write("\x1b]52;c;" + base64.b64encode(text.encode()).decode() + "\a")
        sys.stdout.flush()
        copied = True
    except OSError:
        pass
    return copied


# The list in memory runs oldest to newest: every done item in the order it was done, then the pending ones.

def normalize(items):
    return [i for i in items if i[0]] + [i for i in items if not i[0]]


# text measured in terminal cells: wide characters (CJK, most emoji) take two

def cells(text):
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1
               for c in text)


def cut(text, n):
    """How many characters of text fit in n cells (at least one, so wrapping always advances)."""
    used = 0
    for k, c in enumerate(text):
        used += cells(c)
        if used > n:
            return max(k, 1)
    return len(text)


def clip(text, n):
    return text if cells(text) <= n else text[:cut(text, n - 1)] + "…"


def wrap(text, n):
    lines, line = [], ""
    for word in text.split():
        while cells(word) > n:
            if line:
                lines.append(line)
                line = ""
            k = cut(word, n)
            lines.append(word[:k])
            word = word[k:]
        if not word:
            continue
        if line and cells(line) + 1 + cells(word) > n:
            lines.append(line)
            line = word
        else:
            line = f"{line} {word}" if line else word
    return lines + [line] if line else lines or [""]


# layout

def is_wide(w, h, was):
    slack = -SLACK if was else SLACK
    return w >= WIDE_AT + slack and w > 2 * h + slack


def header(title, todo, done, w):
    for text in (f"next: {title}  ({todo} to do, {done} done)", f"next: {title} · {todo}",
                 f"{title} · {todo}"):
        if cells(text) <= w - 2:
            return text
    return clip(f"{title} · {todo}", w - 2)


def key_grid(w):
    """The keys with what they do in aligned columns, as many columns as the width takes, filled
    row by row. Each row is a list of (offset, key, what), keys right-aligned in their column.
    [] when not even one column fits."""
    for cols in range(len(KEYMAP), 0, -1):
        rows = [KEYMAP[k:k + cols] for k in range(0, len(KEYMAP), cols)]
        kw = [max(len(row[c][0]) for row in rows if c < len(row)) for c in range(cols)]
        ww = [max(len(row[c][1]) for row in rows if c < len(row)) for c in range(cols)]
        if sum(kw) + sum(ww) + cols + 2 * (cols - 1) > w - 2:
            continue
        grid = []
        for row in rows:
            x, line = 0, []
            for c, (key, what) in enumerate(row):
                line.append((x + kw[c] - len(key), key, what))
                x += kw[c] + 1 + ww[c] + 2
            grid.append(line)
        return grid
    return []


def footer(w):
    return next((keys for keys in (KEYS, SHORT_KEYS, TINY_KEYS) if len(keys) <= w - 2), "")


def arrange(items, w, h, wide, foot=1):
    """Lay the list out on a w x h screen whose last foot lines hold the keys.

    Returns (view, panels): view is the items the cursor walks, in order; each panel is
    (x, width, rows) and each row is (index in view or None, text, kind), kind one of
    todo, done, rule, note. Done items take one line each; pending items wrap, their later lines
    lined up under the text. No cursor marker goes into the text; y copies the item without its box.
    """
    body = max(h - 2 - foot, 1)
    done = [i for i in items if i[0]]
    todo = [i for i in items if not i[0]]

    def pending_rows(width, first):
        rows = []
        for n, (_, text) in enumerate(todo):
            for k, line in enumerate(wrap(text, max(width - 5, 4))):
                rows.append((first + n, ("    " if k else "[ ] ") + line, "todo"))
        return rows

    def done_rows(shown, width):
        return [(len(todo) + n, clip("[x] " + text, width - 1), "done") for n, (_, text) in enumerate(shown)]

    def older(hidden, width):
        return [(None, clip(f"… +{hidden} older", width - 1), "note")] if hidden else []

    if wide:
        dw = max(24, min(60, w * 2 // 5))
        pw = w - dw - 4
        fit = len(done) if len(done) <= body else body - 1
        shown = done[::-1][:fit]
        right = done_rows(shown, dw - 1) + older(len(done) - fit, dw - 1)
        return todo + shown, [(1, pw, pending_rows(pw, 0)), (pw + 4, dw - 1, right)]

    pw = w - 2
    rows = pending_rows(pw, 0)
    free = body - len(rows) - 1
    room = max(SHOW_DONE, min(free, body // 2))
    fit = len(done) if len(done) <= room else max(room - 1, SHOW_DONE)  # a row for the older note
    shown = done[::-1][:fit]
    if shown and todo:
        rows.append((None, "-" * min(w - 6, 40), "rule"))
    rows += done_rows(shown, pw) + older(len(done) - fit, pw)
    return todo + shown, [(1, pw, rows)]


def parse(text):
    items = [[line[3] in "xX", line[6:]] for line in text.splitlines()
             if line.startswith(("- [ ] ", "- [x] ", "- [X] "))]
    return normalize(items[::-1])


def render(items):
    return "".join(f"- [{'x' if done else ' '}] {text}\n" for done, text in reversed(items))


def take(items, item):
    del items[next(n for n, i in enumerate(items) if i is item)]


def read(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return ""


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def stamp(path):
    try:
        return os.stat(path).st_mtime_ns
    except FileNotFoundError:
        return None


class App:
    def __init__(self, scr, path, title):
        self.scr, self.path, self.title = scr, path, title
        self.items, self.seen = parse(read(path)), stamp(path)
        self.wide = False
        self.tops = {}       # scroll offset per panel
        self.fresh = []      # (item, when its highlight ends) for items another pane added
        self.history = []
        self.note = None     # (text, when it ends) shown in place of the footer
        self.keys = []       # footer rows of (offset, key, what): the key grid, or one line of letters
        self.focus = None    # the item under the cursor; None until you move, and after Esc

    def layout(self):
        """Spell the keys out under the list while it has the room; once it needs those rows,
        give them back and keep one line of letters."""
        h, w = self.scr.getmaxyx()
        self.wide = is_wide(w, h, self.wide)
        spelled = key_grid(w)
        if len(spelled) > 1:
            view, panels = arrange(self.items, w, h, self.wide, len(spelled))
            if all(len(rows) <= h - 2 - len(spelled) for _, _, rows in panels):
                self.keys = spelled
                return view, panels
        self.keys = [[(0, "", footer(w))]]
        return arrange(self.items, w, h, self.wide)

    def view(self):
        return self.layout()[0]

    @property
    def cur(self):
        return next((n for n, i in enumerate(self.view()) if i is self.focus), None)

    def first(self):
        view = self.view()
        return next((i for i in view if not i[0]), view[0] if view else None)

    def point(self):
        """Keep a selection on a visible item: the first pending one when its own went out of view."""
        if self.focus is not None and self.cur is None:
            self.focus = self.first()

    def load(self, text):
        """Take the list from text, keeping the cursor on the same item and flagging what is new."""
        old = list(self.items)
        self.items = parse(text)
        until = time.monotonic() + FRESH
        for item in self.items:
            if item in old:
                old.remove(item)
            else:
                self.fresh.append((item, until))
        if self.focus is not None:
            self.focus = next((i for i in self.items if i == self.focus), None) or self.first()
        self.point()

    def reload(self):
        if stamp(self.path) != self.seen:
            self.seen = stamp(self.path)
            self.load(read(self.path))

    def change(self, fn):
        """Apply fn(items, view) to the list as it is on disk and save it; fn returns the item the cursor lands on."""
        self.reload()
        before = render(self.items)
        target = fn(self.items, self.view())
        self.items = normalize(self.items)
        after = render(self.items)
        if after != before:
            self.history.append(before)
            write(self.path, after)
            self.seen = stamp(self.path)
        self.focus = target
        self.point()

    # actions (each fn finds its item gone, cur None, when another pane removed it meanwhile;
    # the ones that act on the item under the cursor do nothing while nothing is selected)

    def unselect(self):
        self.focus = None

    def say(self, text):
        self.note = (text, time.monotonic() + NOTE)

    def copy(self):
        if self.cur is None:
            self.say("select an item to copy")
        else:
            self.say("copied" if clipboard(self.focus[1]) else "could not copy")

    def step(self, delta):
        view, cur = self.view(), self.cur
        if cur is None:
            self.focus = self.first()
        elif view:
            self.focus = view[max(0, min(cur + delta, len(view) - 1))]

    def jump(self):
        """Go to the nearest item of the other kind: the other column when wide."""
        view, cur = self.view(), self.cur
        if cur is None:
            self.focus = next((i for i in view if i[0]), self.first())
            return
        others = [n for n, i in enumerate(view) if i[0] != view[cur][0]]
        if others:
            self.focus = view[min(others, key=lambda n: abs(n - cur))]

    def add(self):
        text = self.ask("add: ")
        if text:
            item = [False, text]
            keep = self.focus is not None
            self.change(lambda items, view: items.append(item) or (item if keep else None))

    def edit(self):
        if self.cur is None:
            return
        text = self.ask("edit: ", self.focus[1])
        if text:
            def fn(items, view):
                if self.cur is None:
                    return None
                view[self.cur][1] = text
                return view[self.cur]
            self.change(fn)

    def toggle(self):
        if self.cur is None:
            return
        def fn(items, view):
            if self.cur is None:
                return None
            item = view[self.cur]
            same = [i for i in view if i[0] == item[0]]
            k = next(n for n, i in enumerate(same) if i is item)
            following = same[k + 1] if k + 1 < len(same) else same[k - 1] if k else None
            take(items, item)
            item[0] = not item[0]
            # Done: newest done sits just above the pending items. Reopened: back on top of them.
            items.insert(sum(1 for i in items if i[0]), item)
            return (following or item) if item[0] else item
        self.change(fn)

    def move(self, step):
        if self.cur is None:
            return
        def fn(items, view):
            if self.cur is None:
                return None
            item, j = view[self.cur], self.cur + step
            if 0 <= j < len(view) and view[j][0] == item[0]:
                a = next(n for n, i in enumerate(items) if i is item)
                b = next(n for n, i in enumerate(items) if i is view[j])
                items[a], items[b] = items[b], items[a]
            return item
        self.change(fn)

    def delete(self):
        if self.cur is None:
            return
        def fn(items, view):
            if self.cur is None:
                return None
            take(items, view[self.cur])
            rest = view[:self.cur] + view[self.cur + 1:]
            return rest[min(self.cur, len(rest) - 1)] if rest else None
        self.change(fn)

    def undo(self):
        if self.history:
            text = self.history.pop()
            write(self.path, text)
            self.seen = stamp(self.path)
            self.load(text)
            self.fresh.clear()

    # screen

    def put(self, y, x, text, attr=0):
        h, w = self.scr.getmaxyx()
        if 0 <= y < h and x < w - 1:
            try:
                self.scr.addnstr(y, x, text, w - 1 - x, attr)
            except curses.error:
                pass

    def draw(self):
        self.scr.erase()
        h, w = self.scr.getmaxyx()
        self.point()
        view, panels = self.layout()
        cur = self.cur
        todo = sum(1 for d, _ in self.items if not d)
        self.put(0, 1, header(self.title, todo, len(self.items) - todo, w), STYLE["head"])

        now = time.monotonic()
        self.fresh = [(i, t) for i, t in self.fresh if t > now]
        foot = len(self.keys)
        body = max(h - 2 - foot, 1)
        for p, (x, width, rows) in enumerate(panels):
            mine = [r for r, row in enumerate(rows) if cur is not None and row[0] == cur]
            top = self.tops.get(p, 0)
            if mine:
                top = max(min(top, mine[0]), mine[-1] - body + 1)
            self.tops[p] = top = max(0, min(top, len(rows) - body))
            for y, (n, text, kind) in enumerate(rows[top:top + body]):
                box = text[:4] if text.startswith(("[ ] ", "[x] ")) else ""
                if n is not None and n == cur:
                    # a solid bar across the column, so a wrapped item is one clean block
                    self.put(2 + y, x, text + " " * (width - cells(text)), STYLE["bar"])
                    self.put(2 + y, x, box, STYLE["barbox"])
                    continue
                attr = STYLE["text"] if kind == "todo" else STYLE["dim"]
                if n is not None and any(i is view[n] for i, _ in self.fresh):
                    attr = STYLE["new"]
                self.put(2 + y, x, box, STYLE["dim"] if attr == STYLE["text"] else attr)
                self.put(2 + y, x + len(box), text[len(box):], attr)
        if len(panels) > 1:
            for y in range(2, 2 + body):
                self.put(y, panels[1][0] - 2, "│", STYLE["dim"])
        if not view:
            self.put(2, 1, "nothing yet: press a to add", STYLE["dim"])
        for k, row in enumerate(self.keys):
            for x, key, what in row:
                self.put(h - foot + k, 1 + x, key, STYLE["text"])
                self.put(h - foot + k, 1 + x + (len(key) + 1 if key else 0), what, STYLE["dim"])
        if self.note and self.note[1] > now:
            self.put(h - 1, 1, self.note[0] + " " * max(w - 2 - cells(self.note[0]), 0), STYLE["note"])

    def ask(self, label, text=""):
        buf = list(text)
        curses.curs_set(1)
        self.scr.timeout(-1)
        try:
            while True:
                h, w = self.scr.getmaxyx()
                line = label + "".join(buf)
                shown = line[-(w - 3):]
                self.scr.move(h - 1, 0)
                self.scr.clrtoeol()
                self.put(h - 1, 1, shown, curses.A_BOLD)
                self.scr.move(h - 1, min(1 + len(shown), w - 2))
                key = self.scr.get_wch()
                if key in ("\n", "\r", curses.KEY_ENTER):
                    curses.flushinp()  # a multi-line paste must not run its other lines as keys
                    return "".join(buf).strip()
                if key == "\x1b":
                    return None
                if key in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                    if buf:
                        buf.pop()
                elif key == "\x15":
                    buf.clear()
                elif key == curses.KEY_RESIZE:
                    self.draw()
                elif isinstance(key, str) and key.isprintable():
                    buf.append(key)
        finally:
            curses.curs_set(0)
            self.scr.timeout(1000)

    def run(self):
        curses.curs_set(0)
        self.scr.timeout(1000)  # wake every second to pick up `next <text>` from other panes
        paint()
        while True:
            self.reload()
            self.draw()
            try:
                key = self.scr.get_wch()
            except curses.error:
                continue
            if key == "q":
                return
            elif key == "\x1b":
                self.unselect()
            elif key in ("j", curses.KEY_DOWN):
                self.step(1)
            elif key in ("k", curses.KEY_UP):
                self.step(-1)
            elif key in ("\t", "h", "l", curses.KEY_LEFT, curses.KEY_RIGHT):
                self.jump()
            elif key == "a":
                self.add()
            elif key in ("e", "\n", "\r", curses.KEY_ENTER):
                self.edit()
            elif key in ("x", " "):
                self.toggle()
            elif key == "y":
                self.copy()
            elif key == "J":
                self.move(1)
            elif key == "K":
                self.move(-1)
            elif key in ("d", curses.KEY_DC):
                self.delete()
            elif key == "u":
                self.undo()


def main(argv):
    locale.setlocale(locale.LC_ALL, "")
    root = scope()
    path = list_file(root)
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    if argv[:1] == ["--path"]:
        print(path)
        return 0
    if argv:
        text = " ".join(argv).strip()
        if text:
            items = parse(read(path))
            items.append([False, text])
            write(path, render(normalize(items)))
        return 0
    os.environ.setdefault("ESCDELAY", "25")
    try:
        curses.wrapper(lambda scr: App(scr, path, os.path.basename(root) or root).run())
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
