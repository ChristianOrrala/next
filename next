#!/usr/bin/env python3
"""next: a scratch list of what to do next, scoped to the current folder.

  next          open the list; it stays open and reloads when the file changes
  next <text>   add an item from any pane without opening the list
  next --path   print the file that holds this folder's list

The scope is the git root of the current folder, or the folder itself outside a repo.
Lists live in ~/.local/share/next/ (override with NEXT_DIR), never inside the repo.
The layout follows the pane. Tall: done items above the pending ones, as many as the free rows
allow (at least 3, at most half). Wide (70+ columns and wider than twice the height): pending on
the left, done on the right, newest on top. The file keeps every item forever, newest first.

Keys: a add · e/Enter edit · x/Space done or reopen · J/K move · Tab/h/l other column ·
      d delete · u undo · q quit
"""
import curses
import locale
import os
import subprocess
import sys
import time
import unicodedata

SHOW_DONE = 3    # done items a tall pane shows even when the pending ones fill it
STORE = os.path.expanduser(os.environ.get("NEXT_DIR", "~/.local/share/next"))
KEYS = "a add  e edit  x done  J/K move  tab col  d delete  u undo  q quit"
SHORT_KEYS = "a e x J K tab d u q"
WIDE_AT = 70     # columns before the done items move to their own column
SLACK = 3        # hysteresis around the switch, so dragging a split doesn't flicker
FRESH = 3        # seconds an item added from another pane stays highlighted


def scope():
    try:
        root = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                              capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        root = ""
    return root or os.getcwd()


def list_file(root):
    return os.path.join(STORE, (root.strip("/").replace("/", "-") or "root") + ".md")


# The list in memory runs oldest to newest: every done item in the order it was done, then the pending ones.

def normalize(items):
    return [i for i in items if i[0]] + [i for i in items if not i[0]]


# text measured in terminal cells: wide characters (CJK, most emoji) take two

def cells(text):
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1
               for c in text)


def cut(text, n):
    """How many characters of text fit in n cells (at least one, so wrapping always advances)."""
    used = 0
    for k, c in enumerate(text):
        used += cells(c)
        if used > n:
            return max(k, 1)
    return len(text)


def clip(text, n):
    return text if cells(text) <= n else text[:cut(text, n - 1)] + "…"


def wrap(text, n):
    lines, line = [], ""
    for word in text.split():
        while cells(word) > n:
            if line:
                lines.append(line)
                line = ""
            k = cut(word, n)
            lines.append(word[:k])
            word = word[k:]
        if not word:
            continue
        if line and cells(line) + 1 + cells(word) > n:
            lines.append(line)
            line = word
        else:
            line = f"{line} {word}" if line else word
    return lines + [line] if line else lines or [""]


# layout

def is_wide(w, h, was):
    slack = -SLACK if was else SLACK
    return w >= WIDE_AT + slack and w > 2 * h + slack


def footer(w):
    return next((keys for keys in (KEYS, SHORT_KEYS) if len(keys) <= w - 2), "")


def arrange(items, w, h, wide):
    """Lay the list out on a w x h screen.

    Returns (view, panels): view is the items the cursor walks, in order; each panel is
    (x, width, rows) and each row is (index in view or None, text, kind), kind one of
    todo, done, rule, note. Done items take one line each; pending items wrap.
    """
    body = max(h - 3, 1)
    done = [i for i in items if i[0]]
    todo = [i for i in items if not i[0]]

    def pending_rows(width, first):
        rows = []
        for n, (_, text) in enumerate(todo):
            for k, line in enumerate(wrap(text, max(width - 6, 4))):
                rows.append((first + n, ("[ ] " if k == 0 else "    ") + line, "todo"))
        return rows

    def done_row(n, text, width):
        return (n, clip("[x] " + text, width - 2), "done")

    def older(hidden, width):
        return [(None, clip(f"… +{hidden} older", width - 2), "note")] if hidden else []

    if wide:
        dw = max(24, min(60, w * 2 // 5))
        pw = w - dw - 4
        fit = len(done) if len(done) <= body else body - 1
        shown = done[::-1][:fit]
        right = [done_row(len(todo) + n, text, dw - 1) for n, (_, text) in enumerate(shown)]
        right += older(len(done) - fit, dw - 1)
        return todo + shown, [(1, pw, pending_rows(pw, 0)), (pw + 4, dw - 1, right)]

    pw = w - 2
    left = pending_rows(pw, 0)
    free = body - len(left) - 1
    fit = min(len(done), max(SHOW_DONE, min(free, body // 2)))
    shown = done[len(done) - fit:] if fit else []
    rows = older(len(done) - fit, pw)
    rows += [done_row(n, text, pw) for n, (_, text) in enumerate(shown)]
    if shown and todo:
        rows.append((None, "-" * min(w - 6, 40), "rule"))
    rows += [(len(shown) + n, text, kind) for n, text, kind in left]
    return shown + todo, [(1, pw, rows)]


def parse(text):
    items = [[line[3] in "xX", line[6:]] for line in text.splitlines()
             if line.startswith(("- [ ] ", "- [x] ", "- [X] "))]
    return normalize(items[::-1])


def render(items):
    return "".join(f"- [{'x' if done else ' '}] {text}\n" for done, text in reversed(items))


def take(items, item):
    del items[next(n for n, i in enumerate(items) if i is item)]


def read(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return ""


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def stamp(path):
    try:
        return os.stat(path).st_mtime_ns
    except FileNotFoundError:
        return None


class App:
    def __init__(self, scr, path, title):
        self.scr, self.path, self.title = scr, path, title
        self.items, self.seen = parse(read(path)), stamp(path)
        self.wide = False
        self.tops = {}       # scroll offset per panel
        self.fresh = []      # (item, when its highlight ends) for items another pane added
        self.history = []
        self.focus = next((i for i in self.items if not i[0]), None)  # the item under the cursor

    def layout(self):
        h, w = self.scr.getmaxyx()
        self.wide = is_wide(w, h, self.wide)
        return arrange(self.items, w, h, self.wide)

    def view(self):
        return self.layout()[0]

    @property
    def cur(self):
        return next((n for n, i in enumerate(self.view()) if i is self.focus), 0)

    def point(self):
        """Keep the cursor on a visible item: the first pending one when its own went out of view."""
        view = self.view()
        if not any(i is self.focus for i in view):
            self.focus = next((i for i in view if not i[0]), view[0] if view else None)

    def load(self, text):
        """Take the list from text, keeping the cursor on the same item and flagging what is new."""
        old = list(self.items)
        self.items = parse(text)
        until = time.monotonic() + FRESH
        for item in self.items:
            if item in old:
                old.remove(item)
            else:
                self.fresh.append((item, until))
        self.focus = next((i for i in self.items if i == self.focus), None)
        self.point()

    def reload(self):
        if stamp(self.path) != self.seen:
            self.seen = stamp(self.path)
            self.load(read(self.path))

    def change(self, fn):
        """Apply fn(items, view) to the list as it is on disk and save it; fn returns the item the cursor lands on."""
        self.reload()
        before = render(self.items)
        target = fn(self.items, self.view())
        self.items = normalize(self.items)
        after = render(self.items)
        if after != before:
            self.history.append(before)
            write(self.path, after)
            self.seen = stamp(self.path)
        self.focus = target
        self.point()

    # actions (each fn finds the list empty when another pane cleared it meanwhile)

    def step(self, delta):
        view = self.view()
        if view:
            self.focus = view[max(0, min(self.cur + delta, len(view) - 1))]

    def jump(self):
        """Go to the nearest item of the other kind: the other column when wide."""
        view, cur = self.view(), self.cur
        others = [n for n, i in enumerate(view) if view and i[0] != view[cur][0]]
        if others:
            self.focus = view[min(others, key=lambda n: abs(n - cur))]

    def add(self):
        text = self.ask("add: ")
        if text:
            item = [False, text]
            self.change(lambda items, view: items.append(item) or item)

    def edit(self):
        if not self.view():
            return
        text = self.ask("edit: ", self.view()[self.cur][1])
        if text:
            def fn(items, view):
                if not view:
                    return None
                view[self.cur][1] = text
                return view[self.cur]
            self.change(fn)

    def toggle(self):
        def fn(items, view):
            if not view:
                return None
            item = view[self.cur]
            same = [i for i in view if i[0] == item[0]]
            k = next(n for n, i in enumerate(same) if i is item)
            following = same[k + 1] if k + 1 < len(same) else same[k - 1] if k else None
            take(items, item)
            item[0] = not item[0]
            # Done: newest done sits just above the pending items. Reopened: back on top of them.
            items.insert(sum(1 for i in items if i[0]), item)
            return (following or item) if item[0] else item
        self.change(fn)

    def move(self, step):
        def fn(items, view):
            if not view:
                return None
            item, j = view[self.cur], self.cur + step
            if 0 <= j < len(view) and view[j][0] == item[0]:
                a = next(n for n, i in enumerate(items) if i is item)
                b = next(n for n, i in enumerate(items) if i is view[j])
                items[a], items[b] = items[b], items[a]
            return item
        self.change(fn)

    def delete(self):
        def fn(items, view):
            if not view:
                return None
            take(items, view[self.cur])
            rest = view[:self.cur] + view[self.cur + 1:]
            return rest[min(self.cur, len(rest) - 1)] if rest else None
        self.change(fn)

    def undo(self):
        if self.history:
            text = self.history.pop()
            write(self.path, text)
            self.seen = stamp(self.path)
            self.load(text)
            self.fresh.clear()

    # screen

    def put(self, y, x, text, attr=0):
        h, w = self.scr.getmaxyx()
        if 0 <= y < h and x < w - 1:
            try:
                self.scr.addnstr(y, x, text, w - 1 - x, attr)
            except curses.error:
                pass

    def draw(self):
        self.scr.erase()
        h, w = self.scr.getmaxyx()
        self.point()
        view, panels = self.layout()
        cur = self.cur
        todo = sum(1 for d, _ in self.items if not d)
        head = f"next: {self.title}  ({todo} to do, {len(self.items) - todo} done)"
        self.put(0, 1, head if cells(head) <= w - 2 else clip(f"next: {self.title}", w - 2), curses.A_BOLD)

        now = time.monotonic()
        self.fresh = [(i, t) for i, t in self.fresh if t > now]
        body = max(h - 3, 1)
        for p, (x, width, rows) in enumerate(panels):
            mine = [r for r, row in enumerate(rows) if row[0] == cur]
            top = self.tops.get(p, 0)
            if mine:
                top = max(min(top, mine[0]), mine[-1] - body + 1)
            self.tops[p] = top = max(0, min(top, len(rows) - body))
            for y, (n, text, kind) in enumerate(rows[top:top + body]):
                here = n is not None and n == cur
                attr = curses.A_NORMAL if kind == "todo" else curses.A_DIM
                if n is not None and any(i is view[n] for i, _ in self.fresh):
                    attr = curses.A_BOLD | curses.A_UNDERLINE
                self.put(2 + y, x, ("> " if here else "  ") + text, attr | (curses.A_REVERSE if here else 0))
        if len(panels) > 1:
            for y in range(2, 2 + body):
                self.put(y, panels[1][0] - 2, "│", curses.A_DIM)
        if not view:
            self.put(2, 3, "nothing yet: press a to add", curses.A_DIM)
        self.put(h - 1, 1, footer(w), curses.A_DIM)

    def ask(self, label, text=""):
        buf = list(text)
        curses.curs_set(1)
        self.scr.timeout(-1)
        try:
            while True:
                h, w = self.scr.getmaxyx()
                line = label + "".join(buf)
                shown = line[-(w - 3):]
                self.scr.move(h - 1, 0)
                self.scr.clrtoeol()
                self.put(h - 1, 1, shown, curses.A_BOLD)
                self.scr.move(h - 1, min(1 + len(shown), w - 2))
                key = self.scr.get_wch()
                if key in ("\n", "\r", curses.KEY_ENTER):
                    curses.flushinp()  # a multi-line paste must not run its other lines as keys
                    return "".join(buf).strip()
                if key == "\x1b":
                    return None
                if key in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                    if buf:
                        buf.pop()
                elif key == "\x15":
                    buf.clear()
                elif key == curses.KEY_RESIZE:
                    self.draw()
                elif isinstance(key, str) and key.isprintable():
                    buf.append(key)
        finally:
            curses.curs_set(0)
            self.scr.timeout(1000)

    def run(self):
        curses.curs_set(0)
        self.scr.timeout(1000)  # wake every second to pick up `next <text>` from other panes
        try:
            curses.use_default_colors()
        except curses.error:
            pass
        while True:
            self.reload()
            self.draw()
            try:
                key = self.scr.get_wch()
            except curses.error:
                continue
            if key == "q":
                return
            elif key in ("j", curses.KEY_DOWN):
                self.step(1)
            elif key in ("k", curses.KEY_UP):
                self.step(-1)
            elif key in ("\t", "h", "l", curses.KEY_LEFT, curses.KEY_RIGHT):
                self.jump()
            elif key == "a":
                self.add()
            elif key in ("e", "\n", "\r", curses.KEY_ENTER):
                self.edit()
            elif key in ("x", " "):
                self.toggle()
            elif key == "J":
                self.move(1)
            elif key == "K":
                self.move(-1)
            elif key in ("d", curses.KEY_DC):
                self.delete()
            elif key == "u":
                self.undo()


def main(argv):
    locale.setlocale(locale.LC_ALL, "")
    root = scope()
    path = list_file(root)
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    if argv[:1] == ["--path"]:
        print(path)
        return 0
    if argv:
        text = " ".join(argv).strip()
        if text:
            items = parse(read(path))
            items.append([False, text])
            write(path, render(normalize(items)))
        return 0
    os.environ.setdefault("ESCDELAY", "25")
    try:
        curses.wrapper(lambda scr: App(scr, path, os.path.basename(root) or root).run())
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
